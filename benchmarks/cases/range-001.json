      "response": {
        "current_units": {"temperature_2m": "°C"},
        "current": {"time": "2026-11-16T10:00", "temperature_2m": 14.1},
        "hourly_units": {"temperature_2m": "°C"},
        "hourly": {
          "time": ["2026-11-16T11:00", "2026-11-16T12:00", "2026-11-16T13:00", "2026-11-16T14:00"],
          "temperature_2m": [13.6, 13.1, 12.9, 12.2]
        }
      }
    }
  ],
  "answer": "It is between 10 and 20°C right now, but not above 15°C. All afternoon the temperature stays between 12 and 14°C, and it never drops below 13°C.",
